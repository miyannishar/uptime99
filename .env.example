# .env is git-ignored and read only by the Vite dev server.
# Copy this file to .env and fill in your key to enable AI puzzle rewriting.
# The key is never bundled into browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Spend guards (defaults shown). The dev server refuses further calls for the rest
# of the day once either cap is reached; usage is logged per request in the
# `npm run dev` terminal as "[ai] ... today N tokens ≈ $X".
OPENAI_DAILY_REQUEST_CAP=200
OPENAI_DAILY_TOKEN_CAP=400000
# Only gpt-4o-mini, gpt-4.1-mini and gpt-4.1-nano are accepted; anything else falls back to gpt-4o-mini.
