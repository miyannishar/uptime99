        "restart",
        "upgrade_tier"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "incident_remediation",
          "when": "on_resolve",
          "basis": "severity * 20"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Several customers emailed to say their scheduled reports did not arrive this morning and their digest emails are late by over an hour."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Scheduled job execution rate on the compute layer dropped 60% in the last hour. Jobs that are firing are running significantly off their expected schedule."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "cron-us-01 has missed 14 scheduled jobs since 07:00 UTC. The scheduler is running but jobs are not firing at their configured times."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "cron-us-01's system clock drifted 47 seconds behind NTP after its hypervisor was live-migrated. The scheduler compares wall-clock time to job schedules, so every job whose trigger window fell in that 47-second gap was silently skipped."
        }
      ]
    }
  ]
