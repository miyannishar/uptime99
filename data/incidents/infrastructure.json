          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "object-store-us is returning 503 on every request. The dependency has been fully unreachable for 12 minutes."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "The cloud provider's status page confirms a wide outage affecting their object storage infrastructure in us-east-1. No ETA has been published."
