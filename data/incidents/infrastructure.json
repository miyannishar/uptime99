        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Payments are failing and user data is not saving. Two enterprise customers have already escalated to their account managers."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Data layer error rate is at 94%. Connection attempts are timing out and no reads or writes are completing."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "pg-primary has been unresponsive for six minutes. The node is marked down; no standby has been promoted and all write traffic is failing."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "pg-primary crashed after a storage I/O hang at 08:51 UTC. The process exited with SIGKILL. Failover is manual and no operator has initiated it yet."
        }
      ]
    },
    {
      "id": "failover_jitter",
      "name": "Failover jitter",
      "family": "infrastructure",
      "severity": 1,
      "scope": "instance",
      "group_by": null,
      "target": {
        "tags_all": [
          "auto_failover"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 80,
        "min_users": 5000,
        "cooldown_ticks": 120
      },
      "base_weight": 6,
      "weight_per_target": 2,
      "damage": {
        "health_delta": -15,
        "utilization_delta_pct": 10
      },
      "resolved_by": [
        "restart"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "incident_remediation",
          "when": "on_resolve",
          "basis": "severity * 20"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "A handful of users reported a brief error around 15:22. It seems to have resolved itself, but we are not sure what happened."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Error rate on the data layer spiked to 4.1% for 45 seconds starting at 15:22 UTC, then returned to baseline without intervention."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "pg-primary-b briefly took over as leader at 15:22:14 and handed back to pg-primary-a at 15:22:58. Total disruption: 44 seconds."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "pg-primary-a's heartbeat was delayed 4.2s due to a GC pause under peak load. The failover probe interpreted this as a primary failure and promoted pg-primary-b. The original primary was still alive and reclaimed leadership once the pause cleared."
        }
      ]
    },
    {
      "id": "clock_skew",
      "name": "Clock skew",
      "family": "infrastructure",
      "severity": 2,
      "scope": "instance",
