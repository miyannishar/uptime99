      "damage": {
        "down": true,
        "health_delta": -80
      },
      "resolved_by": [
        "failover",
        "restore_from_backup",
        "restart"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
