        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} (Tier {{current_tier}}) hit its memory limit and the OOM killer terminated the main process. Health is now {{health}}%."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} Tier {{current_tier}} memory limit is exhausted by the current workload. Increase the container memory limit or upgrade to Tier {{current_tier + 1}}."
        }
      ]
