{
  "incidents": [
    {
      "id": "hardware_failure",
      "name": "Hardware failure",
      "family": "infrastructure",
      "severity": 4,
      "scope": "instance",
      "group_by": null,
      "target": {
        "tags_all": [
          "spof"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 20,
        "min_users": 0,
        "cooldown_ticks": 80
      },
      "base_weight": 12,
      "weight_per_target": 4,
      "damage": {
        "down": true,
        "health_delta": -100
      },
      "resolved_by": [
        "restart",
        "add_replica"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "sla_credit",
          "when": "per_tick",
          "basis": "affected_users * credit_rate"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "CEO: \"I have three enterprise customers on the phone telling me everything is down. What is going on?\""
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Uptime on the affected layer collapsed to 0% at 14:07 UTC and has not recovered. Error rate is at 100%."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "app-us-01 has not passed a health check in four minutes. The instance is marked unreachable and is not accepting connections."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "app-us-01's hypervisor reported a fatal hardware fault on the underlying host. The VM has not booted since the host stopped responding to pings at 14:07."
        }
      ]
    },
    {
      "id": "az_outage",
      "name": "Availability zone outage",
      "family": "infrastructure",
      "severity": 4,
      "scope": "group",
      "group_by": "region",
      "target": {
        "tags_all": [
          "single_az"
        ],
        "layers": [
          "compute",
          "data"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 60,
        "min_users": 5000,
        "cooldown_ticks": 200
      },
      "base_weight": 10,
      "weight_per_target": 5,
      "damage": {
        "down": true,
        "health_delta": -40
      },
      "resolved_by": [
        "failover",
        "enable_multi_az"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "sla_credit",
          "when": "per_tick",
          "basis": "affected_users * credit_rate"
        },
        {
          "kind": "data_egress",
          "when": "on_resolve",
          "basis": "affected_instances * 12"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Support queue: 47 tickets in 10 minutes. Users are saying the product is completely inaccessible and has been for a while."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Uptime on compute and data layers dropped from 99.9% to 0% simultaneously. No recovery trend visible."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "All nodes in us-east-1a are unreachable. app-us-01, app-us-02, pg-primary, and redis-01 all failed health checks within the same 30-second window."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "The cloud provider's us-east-1a datacenter lost power at 09:42 UTC. Every node located in that zone lost network reachability at the same timestamp."
        }
      ]
    },
    {
      "id": "region_outage",
      "name": "Regional outage",
      "family": "infrastructure",
      "severity": 5,
      "scope": "group",
      "group_by": "region",
      "target": {
        "tags_all": [
          "single_region"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 150,
        "min_users": 20000,
        "cooldown_ticks": 400
      },
      "base_weight": 4,
      "weight_per_target": 6,
      "damage": {
        "down": true,
        "health_delta": -60
      },
      "resolved_by": [],
      "duration_ticks": 35,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "sla_credit",
          "when": "per_tick",
          "basis": "affected_users * credit_rate"
        },
        {
          "kind": "data_egress",
          "when": "on_expire",
          "basis": "affected_instances * 12"
        },
        {
          "kind": "emergency_premium",
          "when": "on_expire",
          "basis": "severity * 50 * emergency_premium_multiplier"
        },
        {
          "kind": "incident_remediation",
          "when": "on_expire",
          "basis": "severity * 25"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Every channel is lit up. Customers, partners, and the board are asking why nothing works. This is our worst outage in memory."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Every metric flatlined at 11:03 UTC. Uptime, latency, and error rate are all unresponsive across every layer simultaneously."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "Every endpoint in us-east-1 is returning 503. app-us-01 through app-us-04, pg-primary, redis-01, and the load balancer are all unreachable."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "The cloud provider declared a P0 networking incident for the entire us-east-1 region at 11:03 UTC. BGP routes are withdrawn; no traffic can reach any resource in the region."
        }
      ]
    },
