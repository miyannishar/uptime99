      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Payments are failing and user data is not saving. Two enterprise customers have already escalated to their account managers."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "{{layer_name}} layer error rate is at 94%. Connection attempts are timing out and no reads or writes are completing."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} has been unresponsive for six minutes. The node is marked down; no standby has been promoted and all write traffic is failing."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} crashed after a storage I/O hang at 08:51 UTC. The process exited with SIGKILL. Failover is manual and no operator has initiated it yet."
        }
      ]
    },
