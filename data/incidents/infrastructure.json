{
  "incidents": [
    {
      "id": "hardware_failure",
      "name": "Hardware failure",
      "family": "infrastructure",
      "severity": 4,
      "scope": "instance",
      "group_by": null,
      "target": {
        "tags_all": [
          "spof"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 20,
        "min_users": 0,
        "cooldown_ticks": 80
      },
      "base_weight": 12,
      "weight_per_target": 4,
      "damage": {
        "down": true,
        "health_delta": -100
      },
      "resolved_by": [
        "restart",
        "add_replica"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "sla_credit",
          "when": "per_tick",
          "basis": "affected_users * credit_rate"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "CEO: \"I have three enterprise customers on the phone telling me everything is down. What is going on?\""
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "A node in the {{layer_name}} layer has gone completely dark — no heartbeat, no metrics, no response to health checks since 14:07 UTC."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} (Tier {{current_tier}}) is down. Health is {{health}}%. All traffic to this node is failing."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} experienced a hypervisor fault on the underlying host. The node must be restarted to restore service."
        }
      ]
    },
    {
      "id": "az_outage",
      "name": "Availability zone outage",
      "family": "infrastructure",
      "severity": 4,
      "scope": "group",
      "group_by": "region",
      "target": {
        "tags_all": [
          "single_az"
        ],
        "layers": [
          "compute",
          "data"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 60,
        "min_users": 5000,
        "cooldown_ticks": 200
      },
      "base_weight": 10,
      "weight_per_target": 5,
      "damage": {
        "down": true,
        "health_delta": -40
      },
      "resolved_by": [
        "failover",
        "enable_multi_az"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "sla_credit",
          "when": "per_tick",
          "basis": "affected_users * credit_rate"
        },
        {
          "kind": "data_egress",
          "when": "on_resolve",
          "basis": "affected_instances * 12"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Support queue: 47 tickets in 10 minutes. Users are saying the product is completely inaccessible and has been for a while."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Uptime on compute and data layers dropped from 99.9% to 0% simultaneously. No recovery trend visible."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "All nodes in the affected availability zone are unreachable. Multiple compute and data-layer nodes failed health checks simultaneously within a 30-second window."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "The cloud provider declared an availability zone outage. Every node located in the affected zone lost network reachability simultaneously."
        }
      ]
    },
    {
      "id": "region_outage",
      "name": "Regional outage",
      "family": "infrastructure",
      "severity": 5,
      "scope": "group",
      "group_by": "region",
      "target": {
        "tags_all": [
          "single_region"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 150,
        "min_users": 20000,
        "cooldown_ticks": 400
      },
      "base_weight": 4,
      "weight_per_target": 6,
      "damage": {
        "down": true,
        "health_delta": -60
      },
      "resolved_by": [],
      "duration_ticks": 35,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "sla_credit",
          "when": "per_tick",
          "basis": "affected_users * credit_rate"
        },
        {
          "kind": "data_egress",
          "when": "on_expire",
          "basis": "affected_instances * 12"
        },
        {
          "kind": "emergency_premium",
          "when": "on_expire",
          "basis": "severity * 50 * emergency_premium_multiplier"
        },
        {
          "kind": "incident_remediation",
          "when": "on_expire",
          "basis": "severity * 25"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Every channel is lit up. Customers, partners, and the board are asking why nothing works. This is our worst outage in memory."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Every metric flatlined at 11:03 UTC. Uptime, latency, and error rate are all unresponsive across every layer simultaneously."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "Every endpoint in the affected region is returning 503. All compute, data, and delivery nodes are unreachable."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "The cloud provider declared a P0 networking incident for the entire affected region. BGP routes are withdrawn; no traffic can reach any resource in the region."
        }
      ]
    },
