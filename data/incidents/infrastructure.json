      "resolved_by": [
        "warm_cache",
        "restart"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "incident_remediation",
          "when": "on_resolve",
          "basis": "severity * 20"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Users are complaining that everything feels sluggish after what looked like a brief maintenance blip about ten minutes ago."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "p95 latency on the cache layer spiked from 4ms to 220ms. Cache miss rate is running at 98% and has not recovered."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "cache-us-01 was restarted by the watchdog at 10:34 UTC. Its working set is empty and every request is falling through to the database."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "cache-us-01 was terminated after its health check endpoint stopped responding for 30s. All in-memory state was lost on shutdown; the cache has not been warmed since restart."
        }
      ]
    },
    {
      "id": "primary_node_failure",
