          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Memory utilization on the {{layer_name}} layer spiked to 100% at 14:23 UTC and has not recovered. The process was terminated by the operating system."
