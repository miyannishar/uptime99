        {
          "kind": "incident_remediation",
          "when": "on_resolve",
          "basis": "severity * 20"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "A handful of users reported a brief error around 15:22. It seems to have resolved itself, but we are not sure what happened."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Error rate on the {{layer_name}} layer spiked to 4.1% for 45 seconds starting at 15:22 UTC, then returned to baseline without intervention."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "The standby node briefly took over as leader and handed back to {{node_name}}. Total disruption: 44 seconds."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}}'s heartbeat was delayed 4.2s due to a GC pause under peak load. The failover probe interpreted this as a primary failure and promoted the standby. The original primary was still alive and reclaimed leadership once the pause cleared."
        }
      ]
    },
    {
      "id": "clock_skew",
      "name": "Clock skew",
      "family": "infrastructure",
      "severity": 2,
      "scope": "instance",
      "group_by": null,
      "target": {
        "tags_all": [
          "scheduled"
        ]
      },
      "fires_when": null,
      "gates": {
        "min_tick": 30,
        "min_users": 0,
        "cooldown_ticks": 150
      },
      "base_weight": 5,
      "weight_per_target": 3,
      "damage": {
        "health_delta": -25
      },
      "resolved_by": [
        "restart",
        "upgrade_tier"
      ],
      "duration_ticks": null,
      "escalates_to": null,
      "escalate_after_ticks": null,
      "ledger_events": [
        {
          "kind": "incident_remediation",
          "when": "on_resolve",
          "basis": "severity * 20"
        }
      ],
      "signals": [
        {
          "level": 0,
          "requires": null,
          "text": "Several customers emailed to say their scheduled reports did not arrive this morning and their digest emails are late by over an hour."
        },
        {
          "level": 1,
          "requires": {
            "node_ids": [
              "metrics_pipeline"
            ],
            "min_tier": 1
          },
          "text": "Scheduled job execution rate on the {{layer_name}} layer dropped 60% in the last hour. Jobs that are firing are running significantly off their expected schedule."
        },
        {
          "level": 2,
          "requires": {
            "node_ids": [
              "alerting"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}} has missed 14 scheduled jobs since 07:00 UTC. The scheduler is running but jobs are not firing at their configured times."
        },
        {
          "level": 3,
          "requires": {
            "node_ids": [
              "tracing"
            ],
            "min_tier": 2
          },
          "text": "{{node_name}}'s system clock drifted 47 seconds behind NTP after its hypervisor was live-migrated. The scheduler compares wall-clock time to job schedules, so every job whose trigger window fell in that 47-second gap was silently skipped."
        }
      ]
    }
  ]
