    },
    {
      "id": "worker_pool",
      "name": "Worker Pool",
      "layer": "compute",
      "role": "async_runtime",
      "description": "Pulls jobs from a queue and processes them off the synchronous request path. Consumer lag is the primary failure mode — a slow or crashed pool lets backlogs grow silently until upstream queues overflow.",
      "singleton": false,
      "max_instances": 6,
      "provides": [
        "async_processing"
      ],
      "requires": [
        {
          "port": "queue",
          "accepts": [
            "queue"
          ],
          "min": 1,
          "max": 3
        },
        {
          "port": "datastore",
          "accepts": [
            "sql_query"
          ],
          "min": 0,
          "max": 4
        }
      ],
      "overridable_edges": true,
      "tiers": [
        {
          "tier": 1,
          "name": "Single worker",
          "stats": {
            "capacity": 50,
            "capacity_unit": "msgs_sec",
            "base_latency_ms": 0,
            "availability_pct": 99.0,
            "cost_month": 15,
            "provision_time_s": 45,
            "blast_radius": 0.3,
            "concurrency": 4,
            "replicas": 1
          },
          "tags": [
            "async",
            "spof",
            "single_az",
            "no_autoscale"
          ]
        },
        {
          "tier": 2,
          "name": "Worker pool",
          "stats": {
            "capacity": 300,
