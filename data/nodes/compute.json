    {
      "id": "cron_scheduler",
      "name": "Scheduler",
      "layer": "compute",
      "role": "job_scheduler",
      "description": "Triggers jobs on a time-based schedule rather than in response to requests. Silent failures are the primary hazard — a missed or skipped run often goes undetected until data is stale or a downstream process times out.",
      "singleton": true,
      "max_instances": 1,
      "provides": [
        "scheduled_execution"
      ],
      "requires": [
        {
          "port": "target",
          "accepts": [
            "app_backend",
            "queue"
          ],
          "min": 0,
          "max": 4
        }
      ],
      "overridable_edges": true,
      "tiers": [
