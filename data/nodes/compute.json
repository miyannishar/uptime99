    {
      "id": "serverless_fn",
      "name": "Serverless Functions",
      "layer": "compute",
      "role": "app_runtime",
      "description": "Executes application logic on demand without managing servers. Cold starts introduce unpredictable latency spikes at the first request after idle periods, and vendor-side incidents are outside the operator's control.",
      "singleton": false,
      "max_instances": 6,
      "provides": [
        "app_backend"
