{
  "nodes": [
    {
      "id": "app_cluster",
      "name": "Application Cluster",
      "layer": "compute",
      "role": "app_runtime",
      "description": "Runs your application code and serves synchronous HTTP requests. Every request must pass through here, so memory leaks, CPU saturation, and bad deploys all manifest as immediate user-visible errors.",
      "singleton": false,
      "max_instances": 8,
      "provides": [
        "app_backend"
      ],
      "requires": [
        {
          "port": "datastore",
          "accepts": [
            "sql_query"
          ],
          "min": 0,
          "max": 4
        },
        {
          "port": "cache",
          "accepts": [
            "cache"
          ],
          "min": 0,
          "max": 2
        },
        {
          "port": "storage",
          "accepts": [
            "blob_storage"
          ],
          "min": 0,
          "max": 2
        },
        {
          "port": "search",
          "accepts": [
            "search_query"
          ],
          "min": 0,
          "max": 2
        },
        {
          "port": "queue",
          "accepts": [
            "queue"
          ],
          "min": 0,
          "max": 3
        }
      ],
      "overridable_edges": true,
      "tiers": [
        {
          "tier": 1,
          "name": "Single VM",
          "stats": {
            "capacity": 300,
            "capacity_unit": "rps",
            "base_latency_ms": 45,
            "availability_pct": 99.0,
            "cost_month": 25,
            "provision_time_s": 60,
            "blast_radius": 0.8,
            "cpu_cores": 2,
            "ram_gb": 4,
            "replicas": 1
          },
          "tags": [
            "stateless",
            "spof",
            "single_az",
            "no_autoscale",
            "vertically_scalable_only"
          ]
        },
        {
          "tier": 2,
          "name": "Three-node cluster",
          "stats": {
            "capacity": 1500,
            "capacity_unit": "rps",
            "base_latency_ms": 38,
            "availability_pct": 99.5,
            "cost_month": 110,
            "provision_time_s": 120,
            "blast_radius": 0.5,
            "cpu_cores": 4,
            "ram_gb": 8,
            "replicas": 3
          },
          "tags": [
            "stateless",
            "horizontally_scalable",
            "multi_az"
          ]
        },
        {
          "tier": 3,
          "name": "Autoscaling group",
          "stats": {
            "capacity": 8000,
            "capacity_unit": "rps",
            "base_latency_ms": 32,
            "availability_pct": 99.9,
            "cost_month": 380,
            "provision_time_s": 180,
            "blast_radius": 0.35,
            "cpu_cores": 4,
            "ram_gb": 8,
            "replicas": 3,
            "autoscale_max": 20
          },
          "tags": [
            "stateless",
            "horizontally_scalable",
            "multi_az",
            "autoscaling",
            "canary_capable"
          ]
        },
        {
          "tier": 4,
          "name": "Managed Kubernetes, multi-region",
          "stats": {
            "capacity": 40000,
            "capacity_unit": "rps",
            "base_latency_ms": 28,
            "availability_pct": 99.99,
            "cost_month": 1400,
            "provision_time_s": 300,
            "blast_radius": 0.2,
            "cpu_cores": 8,
            "ram_gb": 16,
            "replicas": 6,
            "autoscale_max": 100
