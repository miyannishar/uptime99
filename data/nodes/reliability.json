    {
      "id": "dr_region",
      "name": "Disaster Recovery Region",
      "layer": "reliability",
      "role": "disaster_recovery",
      "description": "Maintains a copy of the system in a separate geographic region so that a full regional failure does not end availability permanently. Cold and warm standby tiers look cheap on paper until an actual disaster reveals that the runbook has never been tested and the replication lag is months behind.",
      "singleton": true,
      "max_instances": 1,
