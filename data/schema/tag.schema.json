{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tags"],
  "properties": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "description", "targeted_by", "resolved_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["weakness", "capability", "property", "posture"] },
          "description": { "type": "string", "minLength": 10 },
          "targeted_by": { "type": "array", "items": { "type": "string" } },
          "resolved_by": { "type": "array", "items": { "type": "string" } },
          "runtime_only": { "type": "boolean" }
        }
      }
    }
  }
}
