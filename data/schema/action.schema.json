{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "minigame", "difficulty",
                     "time_cost_s", "money_cost", "cooldown_s", "constraint", "on_success", "on_fail"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 20 },
          "minigame": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "minigame_pool": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minigame", "difficulty"],
              "properties": {
                "minigame": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          },
          "time_cost_s": { "type": "number", "minimum": 0 },
          "money_cost": { "type": "number", "minimum": 0 },
          "cooldown_s": { "type": "number", "minimum": 0 },
          "constraint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layers": { "type": "array", "items": { "enum": ["edge", "ingress", "compute", "data", "reliability", "observability", "delivery"] } },
              "roles": { "type": "array", "items": { "type": "string" } },
              "node_ids": { "type": "array", "items": { "type": "string" } },
              "tags_all": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tags_any": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "tags_none": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "min_tier": { "type": "integer", "minimum": 1 },
              "max_tier": { "type": "integer", "minimum": 1 },
              "min_health": { "type": "number", "minimum": 0, "maximum": 100 },
              "max_health": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "on_success": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tags_add": { "type": "array", "items": { "type": "string" } },
              "tags_remove": { "type": "array", "items": { "type": "string" } },
              "stats_delta": { "type": "object", "additionalProperties": { "type": "string" } },
              "health_delta": { "type": "number" },
              "tier_delta": { "type": "integer" },
              "cost_delta": { "type": "number" },
              "metrics": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "on_fail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "health_delta": { "type": "number" },
              "tags_add": { "type": "array", "items": { "type": "string" } },
              "metrics": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
