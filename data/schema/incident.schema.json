{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["incidents"],
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": { "type": "array", "items": { "enum": ["edge","ingress","compute","data","reliability","observability","delivery"] } },
        "roles": { "type": "array", "items": { "type": "string" } },
        "node_ids": { "type": "array", "items": { "type": "string" } },
        "tags_all": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tags_any": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tags_none": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "min_tier": { "type": "integer", "minimum": 1 },
        "max_tier": { "type": "integer", "minimum": 1 },
        "min_health": { "type": "number", "minimum": 0, "maximum": 100 },
        "max_health": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "properties": {
    "incidents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","name","family","severity","scope","group_by","target","fires_when",
                     "gates","base_weight","weight_per_target","damage","resolved_by",
                     "duration_ticks","escalates_to","escalate_after_ticks",
                     "ledger_events","signals"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "family": { "enum": ["infrastructure","capacity","data","queue","security","delivery","business"] },
          "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
          "scope": { "enum": ["instance","group","architecture"] },
          "group_by": { "oneOf": [{ "enum": ["region","layer","def_id"] }, { "type": "null" }] },
          "target": { "oneOf": [{ "$ref": "#/$defs/constraint" }, { "type": "null" }] },
          "fires_when": {
            "oneOf": [
              { "type": "object", "additionalProperties": false,
                "minProperties": 1, "maxProperties": 1,
                "properties": {
                  "any_node": { "$ref": "#/$defs/constraint" },
                  "no_node": { "$ref": "#/$defs/constraint" }
                } },
              { "type": "null" }
            ]
          },
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_tick": { "type": "integer", "minimum": 0 },
              "min_users": { "type": "number", "minimum": 0 },
              "cooldown_ticks": { "type": "integer", "minimum": 0 }
            }
          },
          "base_weight": { "type": "number", "minimum": 0 },
          "weight_per_target": { "type": "number", "minimum": 0 },
          "damage": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "down": { "type": "boolean" },
              "health_delta": { "type": "number" },
              "utilization_delta_pct": { "type": "number" },
              "tags_add": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          },
          "resolved_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "duration_ticks": { "type": ["integer", "null"], "minimum": 1 },
          "escalates_to": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" },
          "escalate_after_ticks": { "type": ["integer", "null"], "minimum": 1 },
          "ledger_events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind","when","basis"],
              "properties": {
                "kind": { "enum": ["provision","action","sla_credit","overage",
                                   "emergency_premium","data_egress","incident_remediation"] },
                "when": { "enum": ["on_trigger","per_tick","on_resolve","on_expire"] },
                "basis": { "type": "string", "minLength": 3 }
              }
            }
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level","requires","text"],
              "properties": {
                "level": { "type": "integer", "minimum": 0, "maximum": 3 },
                "requires": { "oneOf": [{ "$ref": "#/$defs/constraint" }, { "type": "null" }] },
                "text": { "type": "string", "minLength": 15 }
              }
            }
          }
        }
      }
    }
  }
}
