{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uptime99 scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "blurb",
    "level",
    "unlocked_by",
    "incident_source",
    "star_target",
    "starting_budget",
    "allowed_layers",
    "board",
    "end",
    "incidents"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "blurb": {
      "type": "string",
      "minLength": 20
    },
    "level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "unlocked_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "incident_source": {
      "enum": [
        "scripted",
        "weighted"
      ]
    },
    "starting_budget": {
      "type": "number",
      "minimum": 0
    },
    "allowed_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "edge",
          "ingress",
          "compute",
          "data",
          "reliability",
          "observability",
          "delivery"
        ]
      }
    },
    "board": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "def_id",
          "tier",
          "region",
          "x",
          "y"
        ],
        "properties": {
          "def_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "end": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ticks"
          ],
          "properties": {
            "kind": {
              "const": "fixed_window"
            },
            "ticks": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "endless"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "objectives"
            }
          }
        }
      ]
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "at_tick"
        ],
        "properties": {
          "incident_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "at_tick": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrival_mean_ticks",
        "severity_max",
        "max_concurrent"
      ],
      "properties": {
        "arrival_mean_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "severity_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_concurrent": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "star_target": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "ticket_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
