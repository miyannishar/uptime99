{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uptime99 stakeholder messages",
  "type": "object",
  "additionalProperties": false,
  "required": ["stakeholders"],
  "properties": {
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "persona", "name", "trigger", "text", "expires_s", "cooldown_ticks", "responses"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "persona": { "enum": ["cto", "support_lead", "investor", "customer", "finance"] },
          "name": { "type": "string", "minLength": 1 },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["metric", "op", "value"],
                "properties": {
                  "metric": { "type": "string" },
                  "op": { "enum": ["lt", "gt"] },
                  "value": { "type": "number" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["incident_severity_gte"],
                "properties": { "incident_severity_gte": { "type": "integer", "minimum": 1, "maximum": 5 } }
              }
            ]
          },
          "text": { "type": "string", "minLength": 20 },
          "expires_s": { "type": "number", "minimum": 20, "maximum": 40 },
          "cooldown_ticks": { "type": "integer", "minimum": 1 },
          "responses": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "reputation_delta", "budget_delta", "reply"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "reputation_delta": { "type": "number", "minimum": -8, "maximum": 5 },
                "budget_delta": { "type": "number", "minimum": -400, "maximum": 0 },
                "reply": { "type": "string", "minLength": 10 }
              }
            }
          }
        }
      }
    }
  }
}
